<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="POSSystem.Maui.Pages.InstallPage"
             Title="POS System - Installation"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="40">
            
            <Image Source="dotnet_bot.png" 
                   HeightRequest="100"
                   WidthRequest="100"
                   HorizontalOptions="Center"
                   Margin="0,20,0,20" />

            <Label Text="Welcome to POS System"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Label Text="Initial Setup"
                   FontSize="24"
                   HorizontalOptions="Center"
                   Margin="0,10,0,20" />

            <Frame BackgroundColor="{StaticResource Primary}"
                   Padding="15"
                   CornerRadius="10"
                   Opacity="0.1">
                <Label Text="Please configure your database connection"
                       TextColor="{StaticResource Gray900}"
                       FontSize="16" />
            </Frame>

            <!-- Database Provider Selection -->
            <Label Text="Database Provider" FontSize="18" FontAttributes="Bold" Margin="0,20,0,5" />
            <Picker x:Name="DatabaseProviderPicker"
                    Title="Select Database Provider"
                    SelectedIndex="0"
                    FontSize="16">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>SQLite (Recommended)</x:String>
                        <x:String>SQL Server</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <!-- SQLite Path (shown by default) -->
            <StackLayout x:Name="SQLiteSection" IsVisible="True" Spacing="10">
                <Label Text="SQLite Database Path" FontSize="18" FontAttributes="Bold" Margin="0,10,0,5" />
                <Label Text="Leave empty to use default platform-specific location" 
                       FontSize="12" 
                       TextColor="{StaticResource Gray500}" />
                <Entry x:Name="SQLitePathEntry"
                       Placeholder="e.g., C:\POSData\pos.db (optional)"
                       FontSize="16" />
            </StackLayout>

            <!-- SQL Server Connection (hidden by default) -->
            <StackLayout x:Name="SqlServerSection" IsVisible="False" Spacing="10">
                <Label Text="SQL Server Connection" FontSize="18" FontAttributes="Bold" Margin="0,10,0,5" />
                
                <Label Text="Server" FontSize="14" />
                <Entry x:Name="ServerEntry"
                       Placeholder="localhost or server address"
                       FontSize="16" />

                <Label Text="Database Name" FontSize="14" />
                <Entry x:Name="DatabaseEntry"
                       Placeholder="POSSystem"
                       Text="POSSystem"
                       FontSize="16" />

                <Label Text="Authentication" FontSize="14" />
                <Picker x:Name="AuthTypePicker"
                        SelectedIndex="0"
                        FontSize="16">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Windows Authentication</x:String>
                            <x:String>SQL Server Authentication</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>

                <StackLayout x:Name="SqlAuthSection" IsVisible="False" Spacing="10">
                    <Label Text="Username" FontSize="14" />
                    <Entry x:Name="UsernameEntry"
                           Placeholder="sa"
                           FontSize="16" />

                    <Label Text="Password" FontSize="14" />
                    <Entry x:Name="PasswordEntry"
                           Placeholder="Password"
                           IsPassword="True"
                           FontSize="16" />
                </StackLayout>
            </StackLayout>

            <!-- Command Timeout -->
            <Label Text="Command Timeout (seconds)" FontSize="18" FontAttributes="Bold" Margin="0,20,0,5" />
            <Label Text="Leave empty for default. Set to 0 for infinite timeout." 
                   FontSize="12" 
                   TextColor="{StaticResource Gray500}" />
            <Entry x:Name="TimeoutEntry"
                   Placeholder="30"
                   Keyboard="Numeric"
                   FontSize="16" />

            <!-- Test Connection Button -->
            <Button x:Name="TestConnectionButton"
                    Text="Test Connection"
                    BackgroundColor="{StaticResource Secondary}"
                    TextColor="{StaticResource Gray900}"
                    Clicked="OnTestConnectionClicked"
                    Margin="0,20,0,0" />

            <Label x:Name="TestResultLabel"
                   Text=""
                   FontSize="14"
                   HorizontalOptions="Center"
                   IsVisible="False" />

            <!-- Install Button -->
            <Button x:Name="InstallButton"
                    Text="Install and Continue"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    FontSize="18"
                    HeightRequest="60"
                    Clicked="OnInstallClicked"
                    Margin="0,20,0,20" />

            <ActivityIndicator x:Name="LoadingIndicator"
                             IsRunning="False"
                             IsVisible="False"
                             Color="{StaticResource Primary}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
