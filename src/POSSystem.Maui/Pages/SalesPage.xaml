<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="POSSystem.Maui.Pages.SalesPage"
             Title="Sales History">

    <Grid RowDefinitions="Auto,*" Padding="10">
        
        <!-- Date Filter -->
        <Grid Grid.Row="0" ColumnDefinitions="*,*,Auto" ColumnSpacing="10" Margin="10">
            <DatePicker Grid.Column="0" Date="{Binding StartDate}" />
            <DatePicker Grid.Column="1" Date="{Binding EndDate}" />
            <Button Grid.Column="2" Text="Filter" Command="{Binding LoadSalesCommand}" />
        </Grid>

        <!-- Sales List -->
        <RefreshView Grid.Row="1" 
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshSalesCommand}">
            <CollectionView ItemsSource="{Binding Sales}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="10,5" Padding="15" CornerRadius="10" HasShadow="True">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                                <Label Grid.Row="0" Text="{Binding SaleDate, StringFormat='{0:MMM dd, yyyy HH:mm}'}" FontSize="16" FontAttributes="Bold" />
                                <Label Grid.Row="1" Text="{Binding Customer.Name, StringFormat='Customer: {0}'}" FontSize="14" TextColor="Gray" />
                                <Label Grid.Row="2" Text="{Binding TotalAmount, StringFormat='Total: ${0:N2}'}" FontSize="18" TextColor="Green" FontAttributes="Bold" />
                                <Label Grid.Row="3" Text="{Binding PaymentMethod, StringFormat='Payment: {0}'}" FontSize="14" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" />
    </Grid>

</ContentPage>
